{
  "$comment": "Recurring access reviews outside access packages: privileged roles, sensitive groups and all guests.",
  "reviews": [
    {
      "name": "Quarterly review - Tier 0 role eligibility",
      "type": "role",
      "roles": [ "Global Administrator", "Privileged Role Administrator", "Privileged Authentication Administrator", "Conditional Access Administrator", "Security Administrator" ],
      "reviewers": { "type": "group", "group": "PIM-Approvers-Tier0" },
