      "defaultDecision": "Deny",
      "autoApply": true,
      "justificationRequired": true
    },
    {
      "name": "Quarterly review - Tier 1 and 2 role eligibility",
      "type": "role",
      "roles": [ "Application Administrator", "Exchange Administrator", "Intune Administrator", "SharePoint Administrator", "User Administrator", "Authentication Administrator", "Helpdesk Administrator", "Global Reader" ],
      "reviewers": { "type": "group", "group": "PIM-Approvers-Tier1" },
      "frequency": "quarterly",
      "durationDays": 14,
      "defaultDecision": "Deny",
      "autoApply": true,
      "justificationRequired": true
    },
    {
      "name": "Quarterly review - Finance application groups",
      "type": "group",
      "groups": [ "APP-ERP-AP-Users", "APP-ERP-GL-Posting" ],
      "reviewers": { "type": "groupOwners" },
      "frequency": "quarterly",
      "durationDays": 14,
      "defaultDecision": "Deny",
      "autoApply": true,
      "justificationRequired": true
    },
    {
      "name": "Monthly review - Guest users in Microsoft 365 groups",
      "type": "guests",
